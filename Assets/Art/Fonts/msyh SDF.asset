    characterSequence: "\u5355\u7403\u8840\u6DB2\u6210\u672C\u5269\u4F59\u8840\u6DB2\u5151\u6362\u7387\u5355\u6B21\u751F\u6210\u6570\u91CF\u5F39\u73E0\u57FA\u7840\u4EF7\u503C\u8D4C\u535A\u6C60\u4EF7\u503C\u4FEE\u6B63\u5355\u7403\u8D21\u732E\u5F39\u73E0\u534A\u5F84\u5F39\u73E0\u8D28\u91CF\u5F39\u6027\u6469\u64E6\u91CD\u529B\u4FEE\u6B63\u53D1\u5C04\u901F\u5EA6\u6700\u5927\u901F\u5EA6\u78C1\u529B\u54CD\u5E94\u751F\u547D\u5468\u671F\u5206\u88C2\u6570\u91CF\u514B\u9686\u4EF7\u503C\u4FDD\u7559\u7387\u7A7F\u900F\u6B21\u6570\u673A\u5668\u500D\u7387\u5168\u5C40\u500D\u7387\u901F\u5EA6\u8BA1\u5206\u52A0\u6210\u8D85\u989D\u6536\u76CA\u8F6C\u5316\u7387\u6301\u7EED\u65F6\u95F4\u5F97\u5206\u500D\u7387\u8870\u51CF\u901F\u5EA6\u5168\u635F\u6982\u7387\u8FD4\u8FD8\u6982\u7387\u53CC\u500D\u6982\u7387\u8D4C\u535A\u6C60\u4EF7\u503C\u673A\u5173\u89E6\u53D1\u7387\u673A\u5173\u51B7\u5374\u5546\u5E97\u4EF7\u683C\u4FEE\u6B63\u91D1\u5E01\u83B7\u53D6\u7387\u56DB\u500D\u6982\u7387\u94F6\u884C\u5165\u7403\u6D88\u8017\u8BE5\u7403\u91D1\u5E01\u5411\u4E0B\u53D6\u6574\u5F53\u524D\u4EF7\u503C\u5151\u6362\u7CFB\u6570\u4E0D\u518D\u5F97\u5206\u6216\u5165\u7B79\u7801\u6C60\u589E\u5E45\u5854\u4E24\u5854\u8DDD\u79BB\u65F6\u8FDE\u7EBF\u8FC7\u7EBF\u4EF7\u503C\u4E58\u79BB\u5FC3\u673A\u5438\u5165\u540E\u4ECE\u6B63\u4E0B\u65B9\u8F93\u51FA\u5B9E\u9645\u901F\u5EA6\u5E76\u53D7\u6700\u5927\u901F\u5EA6\u9650\u5236\u4F20\u9001\u95E8\u8D2D\u4E70\u4E00\u5BF9\u540C\u8272\u95E8\u53CC\u5411\u4F20\u9001\u4FDD\u6301\u901F\u5EA6\u5927\u5C0F\u51FA\u53E3\u65B9\u5411\u7531\u671D\u5411\u51B3\u5B9A\u9ED1\u8272\u56DB\u53F6\u8349\u8FC7\u53F6\u540E\u8BE5\u7403\u4E0B\u4E00\u6B21\u6709\u6548\u5F97\u5206\u7ED3\u7B97\u7684\u68C0\u5B9A\u6982\u7387\u8BBE\u4E3A\u7ED3\u7B97\u65F6\u6700\u591A\u4E00\u6B21\u68C0\u5B9A\u5206\u6D41\u5668\u4EF7\u503C\u65F6\u751F\u6210\u4E24\u7403\u4EF7\u503C\u5404\u534A\u4F53\u79EF\u5404\u534A\u5411\u4E0B\u5DE6\u53F3\u51FA\u5C04\u4EF7\u503C\u4E0D\u5206\u88C2\u5F39\u677F\u88AB\u5F39\u5411\u5F39\u677F\u671D\u5411\u65B9\u5411\u589E\u503C\u900F\u955C\u53CC\u500D\u4EF7\u503C\u7A7F\u8FC7\u540E\u4EF7\u503C\u8D44\u672C\u4E3B\u4E49\u7403\u4EF7\u503C\u88AB\u9500\u6BC1\u4EF7\u503C\u4EF7\u503C\u8840\u7A7F\u70AE\u5C06\u8840\u50A8\u5B58\u5728\u88C5\u7F6E\u4E2D\u5B58\u6EE1\u4EF7\u503C\u540E\u4EE5\u5F62\u5411\u56DB\u65B9\u53D1\u5C04\u8840\u7EBF\u8840\u7EBF\u7ECF\u8FC7\u4E4B\u5904\u5706\u9489\u88AB\u6467\u6BC1\u89E6\u53D1\u540E\u88C5\u7F6E\u9500\u6BC1\u51CF\u901F\u5E26\u7403\u7ECF\u8FC7\u540E\u7403\u901F\u590D\u6D3B\u5427\u6211\u7684\u7231\u4EBA\u7403\u7ECF\u8FC7\u540E\u83B7\u5F97\u590D\u6D3B\u5C5E\u6027\u53EF\u4EE5\u5728\u7ED3\u7B97\u9500\u6BC1\u7B49\u72B6\u6001\u540E\u8FD4\u8FD8\u8840\u6DB2\u6D88\u8017\u91CF\u78C1\u78C1\u78C1\u5706\u5F62\u4E0A\u65B9\u5BF9\u78C1\u5F39\u73E0\u6709\u6392\u65A5\u529B\u4E0B\u65B9\u5BF9\u78C1\u5F39\u73E0\u6709\u5438\u5F15\u529B\u4F1A\u88AB\u5438\u94C1\u77F3\u5438\u5F15\u53D1\u751F\u4F4D\u79FB\u78C1\u573A\u8303\u56F4\u4E3A\u534A\u5F84\u5706\u540C\u4E00\u9897\u7403\u5BF9\u540C\u4E00\u88C5\u7F6E\u53EA\u89E6\u53D1\u4E00\u6B21\u5F97\u5206\u500D\u7387\u540C\u4E00\u9897\u7403\u5BF9\u540C\u4E00\u88C5\u7F6E\u53EA\u89E6\u53D1\u4E00\u6B21\u6982\u7387\u589E\u52A0\u4E2A\u767E\u5206\u70B9\u80BE\u4E0A\u817A\u7D20\u836F\u6548\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u7684\u68C0\u5B9A\u6982\u7387\u6BCF\u6B21\u53D1\u5C04\u8840\u8017\u70E7\u70E7\u679C\u5B9E\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u5728\u671F\u95F4\u5F97\u5206\u989D\u5916\u57FA\u7840\u4EF7\u503C\u5EF6\u957F\u836F\u5242\u836F\u6548\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u7684\u89E6\u53D1\u65F6\u65F6\u957F\u6BCF\u6B21\u53D1\u5C04\u8840\u8017\u6DA6\u6D41\u5242\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u6469\u64E6\u5F39\u6027\u4EF7\u503C\u51DD\u8840\u5242\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u57FA\u7840\u4EF7\u503C\u4F53\u79EF\u8840\u8017\u6447\u5934\u4E38\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u5F39\u6027\u57FA\u7840\u4EF7\u503C\u8840\u8017\u7A00\u8840\u5242\u7A97\u53E3\u5185\u53D1\u5C04\u7403\u6709\u6982\u7387\u7A7F\u8FC7\u5706\u9489\u57